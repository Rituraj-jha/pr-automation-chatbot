# Copy backend_v3/.env to this folder as .env, or fill these values manually.
LLM_PROVIDER=truefoundry_openai
TRUEFOUNDRY_OPENAI_API_KEY=
TRUEFOUNDRY_OPENAI_MODEL=openai/gpt-5-mini
TRUEFOUNDRY_OPENAI_BASE_URL=https://tfy-dev.aiops.cloudapps.cargill.com
LLM_TEMPERATURE=0.1

# Optional, only if your local network requires a custom CA bundle.
CUSTOM_CA_BUNDLE_PATH=

# Optional prompt used by md_llm_client.py when --raw is not passed.
MD_TEST_SYSTEM_PROMPT=You are a concise assistant testing how the application LLM responds to Markdown input.